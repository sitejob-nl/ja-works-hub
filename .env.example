# Voorbeeld-env voor JA Werkt. Kopieer naar `.env` (of zet in Vercel) en vul aan.
# Échte waarden NOOIT committen — `.env`/`.env.local` zijn gitignored.

# --- Frontend (Vite, ingebouwd in de client-bundle) ---
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<supabase publishable/anon key>
# Optioneel, afhankelijk van features:
VITE_SUPABASE_ANON_KEY=<supabase anon key>
VITE_SUPABASE_PROJECT_ID=<project ref>
VITE_MAPBOX_TOKEN=<mapbox token>

# --- Observability: Sentry (Track C) ---
# Zonder VITE_SENTRY_DSN is Sentry een volledige no-op (lokaal/preview sturen niets).
# Zet de DSN in productie (Vercel) om foutrapportage aan te zetten.
VITE_SENTRY_DSN=
# Optioneel: release-tag (Vercel zet automatisch VERCEL_GIT_COMMIT_SHA → gebruikt door de build).
VITE_APP_RELEASE=

# --- Sentry sourcemap-upload (BUILD-ONLY — alleen in Vercel-env, niet in de client) ---
# Alleen nodig als je sourcemaps naar Sentry wilt uploaden. Zonder SENTRY_AUTH_TOKEN
# slaat de build de upload over én genereert geen .map-bestanden.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
