# Voorbeeldconfiguratie voor de JA Werkt-backup.
# Echte versie staat op srv1 als /var/lib/jawerkt-backup/backup.env (mode 600, root).
# Zet hier NOOIT echte waarden in — dit bestand staat in git.

# ─── Database (Supabase) ─────────────────────────────────────────────────────
# Directe host; die heeft alléén een AAAA-record, dus srv1 verbindt over IPv6.
# Fallback bij IPv6-problemen: aws-1-eu-central-1.pooler.supabase.com (session mode,
# poort 5432). LET OP: aws-0 is een andere tenant en poort 6543 is transaction mode,
# die geen pg_dump ondersteunt.
PGHOST=db.<project-ref>.supabase.co
PGPORT=5432
PGUSER=backup_ro
PGDATABASE=postgres
PGPASSFILE=/var/lib/jawerkt-backup/.pgpass

# ─── Borg / Hetzner Storage Box ──────────────────────────────────────────────
# Eigen repo naast backups/srv1, met een eigen passphrase.
BORG_REPO=ssh://<user>@<user>.your-storagebox.de:23/./backups/jawerkt
BORG_PASSCOMMAND=cat /var/lib/jawerkt-backup/.borg-passphrase
BORG_RSH=ssh -i /root/.ssh/id_ed25519_storagebox -o BatchMode=yes

# ─── Sentry (optioneel) ──────────────────────────────────────────────────────
# Zonder DSN meldt de backup zich niet; hij draait gewoon door.
SENTRY_DSN_EDGE=
SENTRY_MONITOR_SLUG=jawerkt-backup
SENTRY_MONITOR_SCHEDULE=20 4 * * *

# ─── Storage-buckets (optioneel) ─────────────────────────────────────────────
# Aanmaken in Supabase: Project Settings -> Storage -> S3 access keys.
# Zolang deze leeg zijn slaat de backup de bestanden over en meldt dat als
# "niet_geconfigureerd" in status.json — zonder nachtelijk vals alarm.
STORAGE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
STORAGE_S3_REGION=eu-central-1
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
